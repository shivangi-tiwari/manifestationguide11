# Email (Resend)
RESEND_API_KEY=                   # server only
INQUIRY_TO_EMAIL=                 # the coach's inbox
INQUIRY_FROM_EMAIL=

# Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=       # optional, from Google Search Console