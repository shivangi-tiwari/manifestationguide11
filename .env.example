# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=            # server only (preview/drafts)
SANITY_API_WRITE_TOKEN=           # server only (inquiries, sync)
SANITY_REVALIDATE_SECRET=

# YouTube sync
YOUTUBE_API_KEY=                  # server only
YOUTUBE_CHANNEL_ID=               # or read from siteSettings
